# Registro de aplicación en Azure AD B2C
# Obtener desde: portal.azure.com → Azure AD B2C → App registrations → <tu-app>
VITE_B2C_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Dominio personalizado del tenant B2C (custom domain configurado en B2C)
VITE_B2C_TENANT_DOMAIN=your-tenant.proteccion.com

# Nombre del tenant en formato onmicrosoft
VITE_B2C_TENANT_ONMICROSOFT=yourtenantname.onmicrosoft.com

# Nombre de la custom policy (IEF) o user flow a utilizar
VITE_B2C_POLICY=b2c_1a_your_policy_name

# URI de redirección registrada como SPA en el app registration
VITE_B2C_REDIRECT_URI=https://localhost:3000
